            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">//Fetch first row of &apos;id&apos; column from JDBC result
// Try fetching the value returned from JDBC query
def spreedlyToken = vars.get(&quot;result_Token_1&quot;)

if (spreedlyToken != null &amp;&amp; spreedlyToken.trim()) {
    vars.put(&quot;spreedly_token&quot;, spreedlyToken)
    log.info(&quot;✅ Extracted spreedly_token: &quot; + spreedlyToken)
} else {
    vars.put(&quot;spreedly_token&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;⚠️ No merchant_id found in JDBC response!&quot;)
}
//Extract the spreedly_token from SQL Query results
def selected = vars.get(&quot;Spreedly_Token&quot;)
def matcher = (selected =~ /spreedly_token=(\w+)/)
if (matcher.find()) {
    vars.put(&quot;selected_spreedly_token&quot;, matcher.group(1))
    log.info(&quot;✅ Cleaned spreedly_token: &quot; + matcher.group(1))
} else {
    vars.put(&quot;selected_spreedly_token&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;⚠️ Unable to extract spreedly_token from &quot; + selected)
}


</stringProp>
