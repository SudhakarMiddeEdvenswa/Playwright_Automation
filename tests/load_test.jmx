          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract first merchant_id" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">//Fetch first row of &apos;id&apos; column from JDBC result
// Try fetching the value returned from JDBC query
def merchantId = vars.get(&quot;result_1&quot;)

if (merchantId != null &amp;&amp; merchantId.trim()) {
    vars.put(&quot;merchant_id&quot;, merchantId)
    log.info(&quot;✅ Extracted merchant_id: &quot; + merchantId)
} else {
    vars.put(&quot;merchant_id&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;⚠️ No merchant_id found in JDBC response!&quot;)
}

def selected = vars.get(&quot;selected_merchant_id&quot;)
def matcher = (selected =~ /id=(\w+)/)
if (matcher.find()) {
    vars.put(&quot;selected_merchant_id_clean&quot;, matcher.group(1))
    log.info(&quot;✅ Cleaned merchant_id: &quot; + matcher.group(1))
} else {
    vars.put(&quot;selected_merchant_id_clean&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;⚠️ Unable to extract merchant_id from &quot; + selected)
}


</stringProp>
          </JSR223PostProcessor>
