            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// Get the response body as string
def responseBody = prev.getResponseDataAsString()

// Parse JSON
def json = new JsonSlurper().parseText(responseBody)

// Check if options object exists
if (!json.options) {
    throw new AssertionError(&quot;⚠️ &apos;options&apos; object not found in response! Full response: ${responseBody}&quot;)
}

// Update the max_webhook_limit_per_event value
def newMaxWebhookLimit = 999999  // &lt;-- set your new value here
json.options.max_webhook_limit_per_event = newMaxWebhookLimit

// Save updated options JSON as a JMeter variable
vars.put(&quot;updatedOptionsJson&quot;, JsonOutput.toJson(json.options))
log.info(&quot;✅ Updated options JSON: &quot; + vars.get(&quot;updatedOptionsJson&quot;))
</stringProp>
          </JSR223PostProcessor>
