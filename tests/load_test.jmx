          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">-- Fatt DB --------------
INSERT INTO fatt${QA_ENV}.merchants
(
    id, mid, status, subdomain, company_name, display_name, contact_name, contact_email, contact_phone,
    address_1, address_2, address_city, address_state, address_zip, hosted_payments_token, plan, options, 
    notes, `currency`, gateway_type, vendor_keys, processor, partner, product_type, is_enterprise, is_payfac,
    is_sandbox, is_test_mode, fm_billing_schedule_id, fee_reconciliation_payment_method_id, welcome_email_sent_at,
    activated_at, created_at, updated_at, deleted_at, brand, risk_hold, reference, merchant_processor_application
)
VALUES 
(
    &apos;${merchantId}&apos;, &apos;${processorOlympusMid}&apos;, &apos;ACTIVE&apos;, &apos;&apos;, &apos;${companyName}&apos;, &apos;${companyName}&apos;, &apos;${merchantName}&apos;,
    &apos;${email}&apos;, &apos;${phone}&apos;, &apos;123 Main Street&apos;, &apos;&apos;, &apos;Broomfield&apos;, &apos;CO&apos;, &apos;80020&apos;, &apos;hosted-payments-${merchantId}&apos;,
    &apos;${merchantPlan}&apos;,
    &apos;{&quot;surcharge_policy&quot;:&quot;always_allow&quot;,&quot;surcharge&quot;:{&quot;enabled&quot;:false,&quot;rate&quot;:0.01},&quot;transaction_limit&quot;:5000}&apos;,
    &apos;&apos;, &apos;[&quot;USD&quot;]&apos;, NULL, &apos;&apos;, &apos;Vantiv&apos;, NULL, &apos;Fattpay Online&apos;, 0, 0, 0, 0, NULL, NULL, NULL,
    NOW(), NOW(), NOW(), NULL, &apos;fattmerchant&apos;, 0, NULL, &apos;payfac&apos;
);

