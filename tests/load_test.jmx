    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;❌ Delete merchant data failed: &quot; + prev.getResponseMessage())
} else {
    log.info(&quot;✅ Delete query executed successfully for merchantId=&quot; + vars.get(&quot;merchantId&quot;))
}
</stringProp>
