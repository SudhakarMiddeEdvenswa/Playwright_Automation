        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC_Request_Get_VendorAccountId" enabled="true">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">-- Onboarding gateway_accounts DB
SELECT vendor_account_id 
FROM onboarding${QA_ENV}.gateway_accounts
WHERE merchant_id = &apos;${merchantId}&apos;
ORDER BY created_at DESC
LIMIT 1;
</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">dbVendorAccountId</stringProp>
          <stringProp name="resultVariable">resultVendorId</stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as Object</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="VendorId Assertion" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Step 1: Get vendor_id from previous API response
def vendorId = vars.get(&quot;vendorId&quot;) // must be set in previous PostProcessor
assert vendorId != null : &quot;❌ vendorId not found from previous API response&quot;

// Step 2: Get vendor_account_id from JDBC Request
// If you set Variable Names in JDBC Request as &quot;dbVendorAccountId&quot;, then:
def dbVendorAccountId = vars.get(&quot;dbVendorAccountId_1&quot;)
assert dbVendorAccountId != null : &quot;❌ DB did not return any vendor_account_id&quot;

// Step 3: Assert equality
assert dbVendorAccountId == vendorId : &quot;❌ DB vendor_account_id (${dbVendorAccountId}) does not match API vendor_id (${vendorId})&quot;

// Step 4: Log success
log.info(&quot;✅ DB vendor_account_id matches API vendor_id: ${vendorId}&quot;)

</stringProp>
          </JSR223Assertion>
