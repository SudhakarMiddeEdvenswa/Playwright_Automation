        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC_Request_Get_PaymentMethodId" enabled="true">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">-- Fatt payment_methods DB
SELECT id FROM fatt${QA_ENV}.payment_methods WHERE merchant_id=&apos;${merchantId}&apos; ORDER BY created_at DESC;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">result</stringProp>
          <stringProp name="resultVariable">Pay_Method_Id</stringProp>
