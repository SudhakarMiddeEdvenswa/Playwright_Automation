          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="VemndorId Extractor" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">VendorId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.vendor_id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">0</stringProp>
