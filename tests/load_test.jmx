        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert_BlockChypMerchant_GatewayCreds" enabled="true">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">-- Fatt Content Feature Merchants DB
INSERT INTO fatt${QA_ENV}.content_features_merchants
(
    feature_id,
    merchant_id,
    created_at,
    updated_at
)
VALUES
(
    &apos;${blockchpACHFeatureId}&apos;,
    &apos;${merchantId}&apos;,
    &apos;${NOW}&apos;,
    &apos;${NOW}&apos;
),
(
    &apos;${blockchpCNPFeatureId}&apos;,
    &apos;${merchantId}&apos;,
    &apos;${NOW}&apos;,
    &apos;${NOW}&apos;
);

-- Fatt Merchant Gateways DB --------------
INSERT INTO fatt${QA_ENV}.merchant_gateways
(
    id,
    merchant_id,
    user_id,
    name,
    `type`,
    vendor,
    `keys`,
    meta,
    processor_mid,
    payfac_type,
    `currency`,
    created_at,
    updated_at,
    deleted_at
)
VALUES
(
    &apos;${blockchypGatewayId1}&apos;,
    &apos;${merchantId}&apos;,
    &apos;${userId}&apos;,
    &apos;${gatewayNameApps}&apos;,
    &apos;${gatewayTypeApps}&apos;,
    &apos;${vendorApps}&apos;, 
    &apos;{&quot;key&quot;:&quot;test&quot;,&quot;gateway&quot;:&quot;achDevelopmentGateway&quot;,&quot;created_at&quot;:&quot;2025-04-01 00:00:00&quot;,&quot;refreshed_at&quot;:null,
    &quot;credentials&quot;:{&quot;account_id&quot;:&quot;107833&quot;,&quot;credential_key&quot;:&quot;omnigateway_blockchyp_test&quot;,
    &quot;tokenizing_key&quot;:&quot;UEtaSEJNWUpNUUpaS0xGSE9RVk5GNkczN0E6R1JMWFY1WlJVVEFTQVRGRlBCRUlVU1VCRFU&quot;},&quot;details&quot;:null}&apos;,
    &apos;{&quot;status&quot;:{&quot;enabled&quot;:false}}&apos;,
    &apos;${processorOlympusACHMid}&apos;,
    &apos;PAYFAC&apos;,
    &apos;[&quot;USD&quot;]&apos;,
    &apos;${createdAt}&apos;,
    &apos;${updatedAt}&apos;,
    NULL
),
(
    &apos;${blockchypGatewayId2}&apos;,
    &apos;${merchantId}&apos;,
    &apos;${userId}&apos;,
    &apos;${gatewayNameCNP}&apos;,
    &apos;${gatewayTypeCNP}&apos;,
    &apos;${vendorCNP}&apos;, 
    &apos;{&quot;key&quot;:&quot;test&quot;,&quot;gateway&quot;:&quot;cnpGateway&quot;,&quot;created_at&quot;:&quot;2025-11-01 00:00:00&quot;,&quot;refreshed_at&quot;:null,
    &quot;credentials&quot;:{&quot;account_id&quot;:&quot;107833&quot;,&quot;credential_key&quot;:&quot;cnpgateway_blockchyp_test&quot;,
    &quot;tokenizing_key&quot;:&quot;VVU0WVJXUkk3Q05WSlVUUTYyU1FYNlhPN006TTQ2M1lRVVhaMklQTVRFNjJWQVdFTTJTVUk&quot;},&quot;details&quot;:null}&apos;,
    &apos;{&quot;status&quot;:{&quot;enabled&quot;:false}}&apos;,
    &apos;${processorOlympusMid}&apos;,
    &apos;PAYFAC&apos;,
    &apos;[&quot;USD&quot;]&apos;,
    &apos;${createdAt}&apos;,
    &apos;${updatedAt}&apos;,
    NULL
);
</stringProp>
