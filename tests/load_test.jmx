          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">-- Engine DB -------

INSERT INTO engine${QA_ENV}.onboarding 
(
    onboarding_id, processor_name, processor_mid, state, created_at, updated_at, deleted_at,
    payfac_id, company_id, merchant_id, user_id, electronic_signature, credit_inquiry_electronic_signature,
    application_agreed_at, countersigned_at, signature_status, application_status, underwriting_status,
    underwriting_substatuses, underwriting_note, first_name, last_name, email, title, phone_number, source,
    business_legal_name, business_dba, business_website, business_fax, business_email,
    business_address_1, business_address_2, business_address_city, business_address_state,
    business_address_zip, business_address_country, owner_address_1, owner_address_2,
    owner_address_city, owner_address_state, owner_address_zip, owner_address_country,
    user_ip, user_ssn, user_dob, business_phone_number, business_tax_id, business_open_date,
    job_title, refund_policy, reason_for_applying, service_you_provide, annual_volume,
    avg_trans_size, highest_trans_amount, card_present_percent, card_not_present_percent,
    card_swiped_percent, moto_percent, b2b_percent, bank_routing_number, bank_account_number,
    bank_account_owner_name, secondary_bank_routing_number, secondary_bank_account_number,
    secondary_bank_account_owner_name, secondary_bank_account_type, secondary_bank_account_purpose,
    principal_owners_name, chosen_plan, chosen_processing_method, referred_by, meta,
    paper_statement, num_of_locs, addl_loc, addl_loc_main_mid, internet, international,
