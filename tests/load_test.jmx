        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC_Request_Get_PM_MetaData" enabled="true">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">-- Fatt payment_methods DB
SELECT meta FROM fatt${QA_ENV}.payment_methods WHERE id = &apos;${Payment_Method_Id}&apos;;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">meta</stringProp>
          <stringProp name="resultVariable">meta_Json_Result</stringProp>
          <stringProp name="queryTimeout"></stringProp>
