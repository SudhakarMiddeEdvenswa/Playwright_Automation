          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// --- Step 1: Get response and status ---
def response = prev.getResponseDataAsString()
def statusCode = prev.getResponseCode() as int

assert statusCode == 200 : &quot;❌ Expected HTTP 200 but got ${statusCode}&quot;

// --- Step 2: Parse JSON safely ---
def json
try {
    json = new JsonSlurper().parseText(response)
} catch (Exception e) {
    log.error(&quot;❌ Invalid JSON: ${e.message}&quot;)
    throw new AssertionError(&quot;Response is not valid JSON:\n${response}&quot;)
}

// --- Step 3: Validate &apos;data&apos; array ---
assert json.data instanceof List : &quot;❌ Expected &apos;data&apos; to be an array, got ${json.data?.getClass()}&quot;
assert !json.data.isEmpty() : &quot;❌ &apos;data&apos; array is empty&quot;

def gateway = json.data[0]

// --- Step 4: Validate core fields ---
assert gateway._tag == &quot;BLOCKCHYP&quot; : &quot;❌ Expected _tag=BLOCKCHYP, got ${gateway._tag}&quot;
assert gateway.vendor_id : &quot;❌ Missing vendor_id&quot;

// --- Step 5: Validate config object ---
assert gateway.config instanceof Map : &quot;❌ Expected &apos;config&apos; to be an object&quot;
assert gateway.config.credentialKey : &quot;❌ Missing &apos;credentialKey&apos;&quot;
assert gateway.config.tokenizingKey : &quot;❌ Missing &apos;tokenizingKey&apos;&quot;

// --- Step 6: Extract credentials and save to JMeter variables ---
vars.put(&quot;credentialKey&quot;, gateway.config.credentialKey)
vars.put(&quot;tokenizingKey&quot;, gateway.config.tokenizingKey)

// --- Step 7: Validate merchant object inside config ---
def merchant = gateway.config.merchant
assert merchant : &quot;❌ Missing &apos;merchant&apos; inside config&quot;
assert merchant.id : &quot;❌ Missing merchant.id&quot;
assert merchant.brand : &quot;❌ Missing merchant.brand&quot;
assert merchant.companyName : &quot;❌ Missing merchant.companyName&quot;
assert merchant.dbaName : &quot;❌ Missing merchant.dbaName&quot;

// --- Step 8: Validate merchant address ---
def address = merchant.address
assert address : &quot;❌ Missing merchant.address&quot;
assert address.containsKey(&quot;addressLineOne&quot;)
assert address.containsKey(&quot;city&quot;)
assert address.containsKey(&quot;countrySubdivision&quot;)
assert address.containsKey(&quot;country&quot;)
assert address.containsKey(&quot;postalCode&quot;)

// --- Step 9: Logging ---
log.info(&quot;✅ vendor_id: ${gateway.vendor_id}&quot;)
log.info(&quot;✅ credentialKey: ${gateway.config.credentialKey}&quot;)
log.info(&quot;✅ tokenizingKey: ${gateway.config.tokenizingKey}&quot;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def credentialKey = vars.get(&quot;credentialKey&quot;)
if (!credentialKey || credentialKey == &quot;NOT_FOUND&quot;) {
    throw new AssertionError(&quot;Expected a valid credentialKey but got: ${credentialKey}&quot;)
}
def tokenizingKey = vars.get(&quot;tokenizingKey&quot;)
if (!tokenizingKey || tokenizingKey == &quot;NOT_FOUND&quot;) {
    throw new AssertionError(&quot;Expected a valid tokenizingKey but got: ${tokenizingKey}&quot;)
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
