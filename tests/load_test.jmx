        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Insert_NewMerchantData_OnEngineDB">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">-- Engine DB -------
INSERT INTO engine${QA_ENV}.companies 
(company_id, state, company_name, `currency`, created_at, updated_at, deleted_at, brand_id, ownership_type, is_public)
VALUES 
(&apos;${companyId}&apos;, &apos;ACTIVE&apos;, &apos;${companyName}&apos;, &apos;[&quot;USD&quot;]&apos;, NOW(), NOW(), NULL, 
 (SELECT brand_id FROM engine${QA_ENV}.brands WHERE brand_name = &apos;${brandName}&apos; LIMIT 1),
 &apos;LLC&apos;, NULL);

SET foreign_key_checks = 0;

INSERT INTO engine${QA_ENV}.payment_methods 
(
method_id, bank_account_type, issuing_bank_name, method_type, cc_method_type, person_name, nickname, user_id, expiration, routing, first_six,   last_four, card_brand, created_at, deleted_at, address_1, address_2, address_city, address_country, address_state, address_zip, has_cvv, is_default, purged_at, vault_token, account_fingerprint, updated_at, meta, dda_account, bank_account_number, bank_account_purpose, state, is_trust
) 
VALUES
(&apos;${methodId}&apos;, &apos;${engPMBankAccountTypeSL}&apos;, &apos;${issuingBankName}&apos;, &apos;${methodType}&apos;, NULL, &apos;${personName}&apos;, &apos;${personName}&apos;, &apos;${userId}&apos;, NULL, &apos;${routing}&apos;, &apos;${firstSix}&apos;, &apos;${lastFour}&apos;, NULL, NOW(), NULL, &apos;${address_1}&apos;, &apos;${address_2}&apos;, &apos;${city}&apos;, &apos;${businessCountry}&apos;, &apos;${businessState}&apos;, &apos;${zip}&apos;, &apos;${enghasCVV}&apos;, &apos;${engIsDefault}&apos;, NULL, NULL, NULL, NOW(), &apos;${meta}&apos;, &apos;${ddaAccount}&apos;, &apos;${bankAccountNumber}&apos;, &apos;${bankAccountPurposeSL}&apos;, NULL, &apos;${isTrust}&apos;
);
INSERT INTO engine${QA_ENV}.payment_methods 
(
method_id, bank_account_type, issuing_bank_name, method_type, cc_method_type, person_name, nickname, user_id, expiration, routing, first_six,   last_four, card_brand, created_at, deleted_at, address_1, address_2, address_city, address_country, address_state, address_zip, has_cvv, is_default, purged_at, vault_token, account_fingerprint, updated_at, meta, dda_account, bank_account_number, bank_account_purpose, state, is_trust
) 
VALUES
(&apos;${engineMethodId}&apos;, &apos;${engPMBankAccountTypeFE}&apos;, &apos;${issuingBankName}&apos;, &apos;${methodType}&apos;, NULL, &apos;${personName}&apos;, &apos;${personName}&apos;, &apos;${userId}&apos;, NULL, &apos;${engineRouting}&apos;, &apos;${engineFirstSix}&apos;, &apos;${engineLastFour}&apos;, NULL, NOW(), NULL, &apos;${address_1}&apos;, &apos;${address_2}&apos;, &apos;${city}&apos;, &apos;${businessCountry}&apos;, &apos;${businessState}&apos;, &apos;${zip}&apos;, &apos;${enghasCVV}&apos;, &apos;${engIsDefault}&apos;, NULL, NULL, NULL, NOW(), &apos;${meta}&apos;, &apos;${ddaAccount}&apos;, &apos;${engineBankAccountNumber}&apos;, &apos;FEES&apos;, NULL, &apos;${isTrust}&apos;
);

INSERT INTO engine${QA_ENV}.companies_payment_methods 
(method_id, company_id) 
VALUES 
(&apos;${methodId}&apos;,&apos;${companyId}&apos;), 
(&apos;${engineMethodId}&apos;, &apos;${companyId}&apos;);

SET foreign_key_checks = 1;
