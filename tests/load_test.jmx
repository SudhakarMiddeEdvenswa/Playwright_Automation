        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="MetaAndToken_PostProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// Replace &quot;meta&quot; with the name of your JDBC variable from JDBC Request
def metaRaw = vars.get(&quot;meta_1&quot;)

if (!metaRaw) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Meta column is null or empty!&quot;)
    return
}

// Remove surrounding quotes if present (JDBC returns JSON as string)
def metaClean = metaRaw.trim()
if (metaClean.startsWith(&apos;&quot;&apos;) &amp;&amp; metaClean.endsWith(&apos;&quot;&apos;)) {
    metaClean = metaClean[1..-2]              // Remove leading and trailing quotes
    metaClean = metaClean.replace(&apos;\\&quot;&apos;, &apos;&quot;&apos;) // Unescape internal quotes
}

def meta
try {
    meta = new JsonSlurper().parseText(metaClean)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Failed to parse meta as JSON: &quot; + e.message)
    return
}

// --- Assertions ---

if (meta.success != true) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion failed: success != true. Actual: ${meta.success}&quot;)
}

if (!meta.token || meta.token.trim().isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion failed: token is missing or empty!&quot;)
}

// Optional: Log token and success for debug
log.info(&quot;✅ Meta parsed successfully. success=${meta.success}, token=${meta.token}&quot;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract MetaDataToken" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.assertions.AssertionResult

// Get the JDBC response
def metaJson = vars.get(&quot;meta_1&quot;)  // Assuming &quot;meta&quot; is the variable name of your JDBC column

if (!metaJson) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Meta column is empty!&quot;)
    return
}

// Parse JSON
def jsonSlurper = new JsonSlurper()
def meta = jsonSlurper.parseText(metaJson)

// Assertions
assert meta.success == true : &quot;Expected success=true but got ${meta.success}&quot;
assert meta.token != null &amp;&amp; meta.token != &quot;&quot; : &quot;Token field is missing or empty&quot;

// Optional: log values
log.info(&quot;✅ Success: ${meta.success}, Token: ${meta.token}&quot;)



</stringProp>
          </JSR223PostProcessor>
