        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC _Req_Get_CompId_From_EngineDB">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">SELECT company_id 
FROM engine${QA_ENV}.companies 
WHERE company_name = &apos;${companyName}&apos; 
ORDER BY created_at DESC 
LIMIT 1;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">companyResult</stringProp>
          <stringProp name="resultVariable">companyResult</stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as Object</stringProp>
        </JDBCSampler>
