          <stringProp name="query">SELECT id FROM fatt${QA_ENV}.payment_methods WHERE merchant_id=&quot;${merchant_id}&quot;;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">result</stringProp>
          <stringProp name="resultVariable">payment_method_id</stringProp>
