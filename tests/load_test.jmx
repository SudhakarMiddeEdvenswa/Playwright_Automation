          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">-- Fatt DB: registrations table INSERT
SET foreign_key_checks = 0;

INSERT INTO fatt${QA_ENV}.registrations
(
    merchant_id, user_id, electronic_signature, credit_inquiry_electronic_signature, 
    application_agreed_at, countersigned_at, signature_status, application_status,
    underwriting_status, underwriting_substatuses, underwriting_note, meta, 
    first_name, last_name, email, title, company_type, entity_ownership_type, phone_number,
    source, promo_code, ref_code, plan, fm_pc_name, business_legal_name, business_dba, 
    business_website, business_fax, business_email, business_address_1, business_address_2,
    business_address_city, business_address_state, business_address_zip, business_address_country,
    owner_address_1, owner_address_2, owner_address_city, owner_address_state, owner_address_zip,
    owner_address_country, user_ip, user_ssn, user_dob, business_phone_number, business_tax_id,
    business_open_date, job_title, refund_policy, reason_for_applying, service_you_provide,created_at,
    updated_at,num_of_locs,addl_loc,addl_loc_main_mid,internet, international, mcc, proc_change, seasonal_flag, 
    seasonal_months,bus_type, sub_bus_type, special_proc, pos_software_publisher,pos_software_name, 
    pos_software_version, site_inspection, location_type,network, bank_account_type, mcc_addl_desc,
    business_location_address_1, business_location_address_2,business_location_address_city, 
    business_location_address_country, business_location_address_state,business_location_address_zip, 
    business_location_email, business_location_fax, business_location_phone_number,
    note, credit_qual_disc_rate, credit_qual_trans_fee, credit_mid_disc_rate, credit_mid_trans_fee,
    credit_non_disc_rate, credit_non_trans_fee, amex_qual_disc_rate, amex_qual_trans_fee, amex_mid_disc_rate,
    amex_mid_trans_fee, amex_non_disc_rate, amex_non_trans_fee, is_flat_rate,pricing_plan,
    annual_gross_ach_revenue, avg_ach_transaction, largest_ach_transaction, cp_transaction_rate,
    cp_per_item_rate, cp_amex_rate, cp_amex_per_item_rate, warnings, merchant_autoverification_authorization,
    chargeback_percent, annual_gross_shopping_cart_revenue, avg_shopping_cart_transaction,
    largest_shopping_cart_transaction, shopping_cart_card_present_percent, shopping_cart_b2b_percent,
    shopping_cart_international, cp_credit_surcharge_rate, cnp_credit_surcharge_rate,
    cp_debit_trans_fee, cnp_debit_trans_fee, cp_debit_discount_rate, cnp_debit_discount_rate,
    field_permissions, drivers_license_id, drivers_license_state, bank_institution_name, external_company_id,
    secondary_bank_institution_name, registration_source, created_by, meta_json, is_trust,
    monthly_minimum_fee, monthly_service_fee, fees
)
VALUES
(
    &apos;${merchantId}&apos;, &apos;${userId}&apos;, NULL, NULL, &apos;${applicationAgreedAt}&apos;, NULL, &apos;SIGNED&apos;, NULL,
    NULL, NULL, NULL, &apos;{&quot;ownership_percentage&quot;:&quot;100&quot;,&quot;owner_citizenship&quot;:&quot;USA&quot;}&apos;,
    &apos;${firstName}&apos;, &apos;${lastName}&apos;, &apos;${email}&apos;, &apos;Managing Member&apos;, &apos;L&apos;, &apos;PRIVATE&apos;, &apos;${phone}&apos;,
    NULL, NULL, NULL, NULL, NULL, &apos;${companyName}&apos;, &apos;${companyName}&apos;,
    &apos;${website}&apos;, NULL, &apos;${email}&apos;, &apos;${businessAddress1}&apos;, &apos;${businessAddress2}&apos;,
    &apos;${businessCity}&apos;, &apos;${businessState}&apos;, &apos;${businessZip}&apos;, &apos;${businessCountry}&apos;,
    &apos;${ownerAddress1}&apos;, &apos;${owner_address_2}&apos;, &apos;${ownerCity}&apos;, &apos;${ownerState}&apos;, &apos;${ownerZip}&apos;, &apos;${ownerCountry}&apos;,
    &apos;${userIp}&apos;, &apos;${userSSN}&apos;, &apos;${userDob}&apos;, &apos;${phone}&apos;, &apos;${taxId}&apos;,
    &apos;${businessOpenDate}&apos;, &apos;${jobTitle}&apos;, &apos;${refundPolicy}&apos;, &apos;${reasonForApplying}&apos;, &apos;${serviceYouProvide}&apos;,
    &apos;${createdAt}&apos;,&apos;${updatedAt}&apos;,&apos;${numOfLocs}&apos;,&apos;${addlLoc}&apos;, &apos;${addlLocMainMid}&apos;, &apos;${internet}&apos;, &apos;${international}&apos;,
    &apos;${mcc}&apos;, &apos;${procChange}&apos;, &apos;${seasonalFlag}&apos;, &apos;${seasonalMonths}&apos;, &apos;${busType}&apos;, &apos;${subBusType}&apos;, &apos;${specialProc}&apos;,
    &apos;${posSoftwarePublisher}&apos;, &apos;${posSoftwareName}&apos;, &apos;${posSoftwareVersion}&apos;, &apos;${siteInspection}&apos;, &apos;${locationType}&apos;,
    &apos;${network}&apos;, &apos;${bankAccountType}&apos;, &apos;${mccAddlDesc}&apos;,&apos;${businessLocationAddress1}&apos;, &apos;${businessLocationAddress2}&apos;,
    &apos;${businessLocationCity}&apos;, &apos;${businessLocationCountry}&apos;, &apos;${businessLocationState}&apos;, &apos;${businessLocationZip}&apos;,
    &apos;${businessLocationEmail}&apos;, &apos;${businessLocationFax}&apos;, &apos;${businessLocationPhoneNumber}&apos;, &apos;${note}&apos;,
    &apos;${creditQualDiscRate}&apos;, &apos;${creditQualTransFee}&apos;, &apos;${creditMidDiscRate}&apos;, &apos;${creditMidTransFee}&apos;,
    &apos;${creditNonDiscRate}&apos;, &apos;${creditNonTransFee}&apos;, &apos;${amexQualDiscRate}&apos;, &apos;${amexQualTransFee}&apos;, &apos;${amexMidDiscRate}&apos;,
    &apos;${amexMidTransFee}&apos;, &apos;${amexNonDiscRate}&apos;, &apos;${amexNonTransFee}&apos;, &apos;${isFlatRate}&apos;, &apos;${pricingPlan}&apos;,
    &apos;${annualGrossAchRevenue}&apos;, &apos;${avgAchTransaction}&apos;, &apos;${largestAchTransaction}&apos;, &apos;${cpTransactionRate}&apos;,
    &apos;${cpPerItemRate}&apos;, &apos;${cpAmexRate}&apos;, &apos;${cpAmexPerItemRate}&apos;, 
    &apos;${warnings}&apos;,&apos;{&quot;ip&quot;: &quot;127.0.0.1&quot;, &quot;email&quot;: &quot;demo@fattmerchant.com&quot;, &quot;user_id&quot;: &quot;user1&quot;, &quot;timestamp&quot;: &quot;2025-11-03 09:24:56&quot;, 
    &quot;browser_agent&quot;: &quot;Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) Chrome/101&quot;}&apos;,
    &apos;${chargebackPercent}&apos;, &apos;${annualGrossShoppingCartRevenue}&apos;, &apos;${avgShoppingCartTransaction}&apos;,
    &apos;${largestShoppingCartTransaction}&apos;, &apos;${shoppingCartCardPresentPercent}&apos;, &apos;${shoppingCartB2BPercent}&apos;,
    &apos;${shoppingCartInternational}&apos;, &apos;${cpCreditSurchargeRate}&apos;, &apos;${cnpCreditSurchargeRate}&apos;,
    &apos;${cpDebitTransFee}&apos;, &apos;${cnpDebitTransFee}&apos;, &apos;${cpDebitDiscountRate}&apos;, &apos;${cnpDebitDiscountRate}&apos;,
    &apos;${fieldPermissions}&apos;, &apos;${driversLicenseId}&apos;, &apos;${driversLicenseState}&apos;, &apos;${bankInstitutionName}&apos;, &apos;${externalCompanyId}&apos;,
    &apos;${secondaryBankInstitutionName}&apos;, &apos;${registrationSource}&apos;, 
    &apos;${createdBy}&apos;, &apos;{&quot;owner_citizenship&quot;: &quot;USA&quot;, &quot;ownership_percentage&quot;: &quot;100&quot;}&apos;, &apos;${isTrust}&apos;,
    &apos;${monthlyMinimumFee}&apos;, &apos;${monthlyServiceFee}&apos;, &apos;${fees}&apos;
);

SET foreign_key_checks = 1;</stringProp>
