        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC_Req_Delete_NewMerchant" enabled="true">
          <stringProp name="dataSource">MySQLConnTest</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">-- Delete from merchant_user joined with merchants
DELETE mu 
FROM fatt${QA_ENV}.merchant_user mu
INNER JOIN fatt${QA_ENV}.merchants me
    ON mu.merchant_id = me.id
WHERE me.company_name LIKE CONCAT(&apos;%&apos;, &apos;${companyName}&apos;, &apos;%&apos;)
  AND mu.user_id = &apos;${userId}&apos;;

-- Make sure the JDBC URL points to the right DB; otherwise USE statement may fail
-- USE fatt${QA_ENV};  -- optional, can be set in JDBC URL

DELETE t, mc, c, i, pm, pl
FROM fatt${QA_ENV}.merchants m
LEFT JOIN fatt${QA_ENV}.transactions t
    ON t.merchant_id = m.id
LEFT JOIN fatt${QA_ENV}.merchant_customer mc
    ON mc.merchant_id = m.id
LEFT JOIN fatt${QA_ENV}.customers c
    ON c.id = mc.customer_id
LEFT JOIN fatt${QA_ENV}.invoices i
    ON i.merchant_id = m.id
LEFT JOIN fatt${QA_ENV}.payment_methods pm
    ON pm.merchant_id = m.id
LEFT JOIN fatt${QA_ENV}.payment_links pl
    ON pl.merchant_id = m.id
WHERE m.id = &apos;${merchantId}&apos;;

-- Clean Up Fatt Schema Data
DELETE 
    fatt${QA_ENV}.transactions, 
    fatt${QA_ENV}.merchant_customer, 
    fatt${QA_ENV}.customers, 
    fatt${QA_ENV}.invoices, 
    fatt${QA_ENV}.payment_methods,
    fatt${QA_ENV}.payment_links
FROM fatt${QA_ENV}.merchants 
    LEFT JOIN fatt${QA_ENV}.transactions 
        ON fatt${QA_ENV}.transactions.merchant_id = fatt${QA_ENV}.merchants.id 
    LEFT JOIN fatt${QA_ENV}.merchant_customer 
        ON fatt${QA_ENV}.merchant_customer.merchant_id = fatt${QA_ENV}.merchants.id 
    LEFT JOIN fatt${QA_ENV}.customers 
        ON fatt${QA_ENV}.customers.id = fatt${QA_ENV}.merchant_customer.customer_id 
    LEFT JOIN fatt${QA_ENV}.invoices
        ON fatt${QA_ENV}.invoices.merchant_id = fatt${QA_ENV}.merchants.id
    LEFT JOIN fatt${QA_ENV}.payment_methods
        ON fatt${QA_ENV}.payment_methods.merchant_id = fatt${QA_ENV}.merchants.id
    LEFT JOIN fatt${QA_ENV}.payment_links
        ON fatt${QA_ENV}.payment_links.merchant_id = fatt${QA_ENV}.merchants.id
WHERE fatt${QA_ENV}.merchants.id = &apos;${merchantId}&apos;;
	  
-- CleanUp merchant DB
DELETE FROM fatt${QA_ENV}.merchants WHERE id = &apos;${merchantId}&apos;;
-- CleanUp fatt.registrations DB
SET foreign_key_checks = 0;

DELETE FROM fatt${QA_ENV}.registrations WHERE merchant_id = &apos;${merchantId}&apos;;

SET foreign_key_checks = 1;
</stringProp>
