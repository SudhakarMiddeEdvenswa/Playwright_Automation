        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract first payment_method_id" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Get the first user id
def selected = vars.get(&quot;payment_method_id&quot;)
def matcher = (selected =~ /id=(\w+)/)
if (matcher.find()) {
    vars.put(&quot;selected_payment_method_id_clean&quot;, matcher.group(1))
    log.info(&quot;✅ Cleaned payment_method_id: &quot; + matcher.group(1))
} else {
    vars.put(&quot;selected_payment_method_id_clean&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;⚠️ Unable to extract payment_method_id from &quot; + selected)
}
//Get the first payment_method_id
def count = vars.get(&quot;result_#&quot;) as int
if (count &gt; 0) {
    for (i in 1..count) {
        def id = vars.get(&quot;result_&quot; + i)
        log.info(&quot;✅ Found payment_method_id_&quot; + i + &quot;: &quot; + id)
    }
    vars.put(&quot;payment_method_id&quot;, vars.get(&quot;result_1&quot;)) // use the first one
} else {
    vars.put(&quot;payment_method_id&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;⚠️ No merchant_id found in JDBC response!&quot;)
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Simulate the same logic you had in JavaScript
def CompanyId = vars.get(&quot;companyId&quot;)   // get existing JMeter variable (from prior sampler)
if (CompanyId == null) {
    CompanyId = &quot;fallback12345&quot;         // fallback if null
}

// Equivalent of your JavaScript logic:
def company = &quot;CO&quot; + CompanyId
        .replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)
        .substring(Math.min(5, CompanyId.length()))
        .toUpperCase()

// Store the value into a JMeter variable
vars.put(&quot;company&quot;, company)
log.info(&quot;✅ Generated Company Code: &quot; + company)

// paymentMethodId
def MethodId = vars.get(&quot;methodId&quot;)   // get existing JMeter variable (from prior sampler)
if (MethodId == null) {
    MethodId = &quot;fallback12345&quot;         // fallback if null
}

// Equivalent of your JavaScript logic:
def method = &quot;PM&quot; + MethodId
        .replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)
        .substring(Math.min(5, MethodId.length()))
        .toUpperCase()

// Store the value into a JMeter variable
vars.put(&quot;method&quot;, method)
log.info(&quot;✅ Generated Method Code: &quot; + method)

//engineMethodId
def engMethodId = vars.get(&quot;engineMethodId&quot;)   // get existing JMeter variable (from prior sampler)
if (engMethodId == null) {
    engMethodId = &quot;fallback12345&quot;         // fallback if null
}

// Equivalent of your JavaScript logic:
def methodOne = &quot;PM&quot; + engMethodId
        .replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)
        .substring(Math.min(5, engMethodId.length()))
        .toUpperCase()

// Store the value into a JMeter variable
vars.put(&quot;engine method&quot;, methodOne)
log.info(&quot;✅ Generated Engone Method Code: &quot; + methodOne)

//onboardingIdOlympus
def onboardingId = vars.get(&quot;onboardingIdOlympus&quot;)   // get existing JMeter variable (from prior sampler)
if (onboardingId == null) {
    onboardingId = &quot;fallback12345&quot;         // fallback if null
}

// Equivalent of your JavaScript logic:
def onboarding = &quot;ON&quot; + onboardingId
        .replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)
        .substring(Math.min(5, onboardingId.length()))
        .toUpperCase()

// Store the value into a JMeter variable
vars.put(&quot;onboardingId&quot;, onboarding)
log.info(&quot;✅ Generated Engone Method Code: &quot; + onboarding)

//onboardingIdOlympusACH
def onboardingOlmpId = vars.get(&quot;onboardingIdOlympusACH&quot;)   // get existing JMeter variable (from prior sampler)
if (onboardingOlmpId == null) {
    onboardingOlmpId = &quot;fallback12345&quot;         // fallback if null
}

// Equivalent of your JavaScript logic:
def onboardingOne = &quot;ON&quot; + onboardingOlmpId
        .replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)
        .substring(Math.min(5, onboardingOlmpId.length()))
        .toUpperCase()

// Store the value into a JMeter variable
vars.put(&quot;onboardingIdOne&quot;, onboardingOne)
log.info(&quot;✅ Generated onboardingOlmp Code: &quot; + onboardingOne)

// payfacIdOlympus
def payfacId = vars.get(&quot;payfacIdOlympus&quot;)   // get existing JMeter variable (from prior sampler)
if (payfacId == null) {
    payfacId = &quot;fallback12345&quot;         // fallback if null
}

// Equivalent of your JavaScript logic:
def payfac = &quot;PF&quot; + payfacId
        .replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;)
        .substring(Math.min(5, payfacId.length()))
        .toUpperCase()

// Store the value into a JMeter variable
vars.put(&quot;payfacIdOlympus&quot;, payfac)
log.info(&quot;✅ Generated payfacIdOlympus Code: &quot; + payfac)

//Define Default NULL value at UDV on Jmeter
def purgedAt = vars.get(&quot;jmeterNULL&quot;)

if (!purgedAt || purgedAt.equalsIgnoreCase(&quot;NULL&quot;)) {
    vars.put(&quot;jmNull&quot;, &quot;NULL&quot;) // real SQL NULL
} else {
    vars.put(&quot;jmNull&quot;, &quot;&apos;${jmeterNULL}&apos;&quot;) // quoted string for valid datetime
}








</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
